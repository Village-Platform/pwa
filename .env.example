# Must end with /api/v1/ (same rule as the Android app's AGHOUR_API_URL_*).
VITE_API_URL=https://base_url/api/v1/

# Firebase web app (Firebase console → Project settings → Your apps → add a Web app). All optional:
# without them Analytics and push stay off. Use the same project as the Android release build (aghour-app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Analytics (Google Analytics 4), "G-..."
VITE_FIREBASE_MEASUREMENT_ID=
# Web push: Cloud Messaging → Web Push certificates → key pair (public key)
VITE_FIREBASE_VAPID_KEY=
