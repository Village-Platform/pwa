{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    // JS and TS live side by side while screens are migrated. JS files are not type-checked (yet),
    // but TS files get their types from them.
    "allowJs": true,
    "checkJs": false,
    "paths": { "@/*": ["./src/*"] },
    "types": ["vite/client", "vite-plugin-pwa/client"]
  },
  "include": ["src", "tests"]
}
